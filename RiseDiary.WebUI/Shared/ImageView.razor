@inject NavigationManager NavManager

<div style="position: fixed;
    width: 100%;
    height: 100%;
    left: 0;
    top: 0;
    padding-top:5px;
    background: rgba(51,51,51,0.7);
    z-index: 10;">

    <div>
        <div class="text-center mb-1">
            <img 
                alt-text="image"
                id="img"
                name="img"
                src="@ImageUri"
                style="max-width:95vw;max-height:95vh;object-fit:cover;" @ondblclick="@RefreshImage" />
        </div>

        @if (ShowButtons)
        {
            <div class="text-center">
                <button @onclick="() => CloseImageView()" type="button" class="btn btn-sm btn-info mx-2">Закрыть</button>
                <a href="/images/edit/@ImageId/@RecordId" class="btn btn-sm btn-info mx-2">Изменить</a>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Guid ImageId { get; set; }

    [Parameter]
    public bool ShowButtons { get; set; }

    [Parameter]
    public Action CloseImageView { get; set; } = () => { };

    [Parameter]
    public Guid? RecordId { get; set; }

    [Parameter]
    public bool RefreshImageCash { get; set; } = false;

    private string ImageUri => $"/api/image-file/{ImageId.ToString()}" + (RefreshImageCash ? $@"?viewId={Guid.NewGuid()}" : "");

    private void RefreshImage()
    {
        RefreshImageCash = true;
        StateHasChanged();
    }
}
