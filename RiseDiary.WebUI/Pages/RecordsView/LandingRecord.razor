@using RiseDiary.Common.Abstractions.Clients
@using RiseDiary.Common.Settings

@inherits UIComponentBase

@inject ISettingsClient SettingsApiClient

@if (HasError)
{
    <p style="color:red">@ErrorMessage</p>
}

<Spinner ShowAnimation="false" Loading="Loading">
    @if (!OnStartPage)
    {
        <button @onclick="SetOnStartPage" class="btn btn-link pt-0" style="float:right" title="Поместить на стартовую страницу">
            <img src="img/calendar-plus.svg" />
        </button>
    }
    else
    {
        <button @onclick="RemoveFromStartPage" class="btn btn-link pt-0" style="float:right" title="Удалить со стартовой страницы">
            <img src="img/calendar-x.svg" />
        </button>
    }
</Spinner>


    @code{
    [Inject]
    public ILogger<LandingRecord> Logger { get; set; } = null!;

    [Inject]
    public HttpClient Http { get; set; } = null!;

    [Parameter, EditorRequired]
    public Guid RecordId { get; set; }

    [Parameter, EditorRequired]
    public Guid[] StartPageRecords { get; set; } = [];

    private bool OnStartPage => StartPageRecords.Contains(RecordId);

    private async Task SetOnStartPage()
    {
        try
        {
            await StartApiRequest();

            var newArray = StartPageRecords.Union([RecordId]).ToArray(); 
            await FinishApiRequest(await UpdateSetting(newArray));
        }
        catch (Exception exc)
        {
            Logger.LogWarning(exc, "Error on updating start page record. Record Id = '{recordId}'", RecordId);
            await FinishApiRequest(exc.Message);
        }
    }

    private async Task RemoveFromStartPage()
    {
        try
        {
            await StartApiRequest();

            var newArray = StartPageRecords.Except([RecordId]).ToArray();
            await FinishApiRequest(await UpdateSetting(newArray));
        }
        catch (Exception exc)
        {
            Logger.LogWarning(exc, "Error on removing start page record. Record Id = '{recordId}'", RecordId);
            await FinishApiRequest(exc.Message);
        }
    }

    private async Task<string?> UpdateSetting(Guid[] recordsIds)
    {
        var dto = new BookmarksSettingsDto
        {
            Records = recordsIds
        };

        var result = await SettingsApiClient.UpdateAsync(SettingKey.Bookmarks, dto, CancellationToken);

        if (result.Succeeded)
        {
            StartPageRecords = recordsIds;
        }

        return result.Message;
    }
}
