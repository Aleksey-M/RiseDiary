@page "/"
@page "/index"

@using RiseDiary.Common.Abstractions.Clients
@using RiseDiary.Common.Records
@using RiseDiary.WebUI.Services

@inject MarkdownService MdService
@inject HttpClient Http
@inject IRecordsSearchClient SearchClient

@inherits UIComponentBase

<PageTitle>Закладки</PageTitle>

<div class="col-12 p-2">
    <Spinner Loading="Loading">
        @if (_records != null)
        {
            <h3 class="p-3 text-center">Закладки</h3>

            @if (HasError)
            {
                <pre style="color:red;">@ErrorMessage</pre>
            }

            @if (_records.Length == 0)
            {
                <h3 class="p-3" style="color:silver">Пусто</h3>
            }

            @if (_records.Length > 0)
            {
                <RecordsTableExpanded Records="_records" TotalCount="(int?)null">
                </RecordsTableExpanded>
            }
        }
    </Spinner>
</div>

@code {

    private RecordDto[]? _records = null;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await StartApiRequest();

        var resp = await SearchClient.GetBookmarks(CancellationToken);
        if (resp.Succeeded && resp.Data != null)
        {
            _records = resp.Data.ToArray();
        }
        else
        {
            _records = [];
        }

        await FinishApiRequest(resp);
    }
}