@page "/"
@page "/index"

@using RiseDiary.Common.Records
@using RiseDiary.Front.Services

@inject MarkdownService MdService
@inject HttpClient Http
@inject NavigationManager NavManager

@inherits UIComponentBase

<PageTitle>Закладки</PageTitle>

<div class="col-12 p-2">
    <Spinner Loading="_loading">
        @if (_records != null)
        {
            <h3 class="p-3 text-center">Закладки</h3>

            @if (HasError)
            {
                <pre style="color:red;">@ErrorMessage</pre>
            }

            @if (_records.Length == 0)
            {
                <h3 class="p-3" style="color:silver">Пусто</h3>
            }

            @if (_records.Length > 0)
            {
                <RecordsTableExpanded Records="_records" TotalCount="(int?)null">
                </RecordsTableExpanded>
            }
        }
    </Spinner>
</div>

@code {

    private RecordDto[]? _records = null;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            _records = await Http.GetFromJsonAsync<RecordDto[]>("api/bookmarks", CancellationToken) ?? [];
            foreach (var r in _records)
            {
                r.SetBaseUri(NavManager.BaseUri);
            }

            _loading = false;
        }
        catch (Exception exc)
        {
            ErrorMessage = exc.Message;
            _records = [];
        }
    }
}